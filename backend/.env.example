# Which flight-data provider the backend calls: "aviationstack" (the default)
# or "aerodatabox". Only the selected provider's API key has to be set; the app
# refuses to start without it. docs/decisions/0001-data-source-strategy.md
# compares the two.
FLIGHT_PROVIDER=aviationstack

# Required when FLIGHT_PROVIDER=aviationstack.
# Sign up at https://aviationstack.com/ to get a free API key.
AVIATIONSTACK_API_KEY=your_api_key_here

# Required when FLIGHT_PROVIDER=aerodatabox. AeroDataBox is reached through
# RapidAPI, so this is your RapidAPI key (the X-RapidAPI-Key value): subscribe
# to a plan at https://rapid.aerodatabox.com/pricing to get one.
AERODATABOX_API_KEY=

# The RapidAPI gateway for AeroDataBox. The default is right unless RapidAPI
# gives you a different host.
# AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com

# How long (seconds) to cache flight results per airport/type before refetching.
# The frontend polls every 45 seconds, so this value, not the polling rate,
# decides how often an open board reaches the provider: 3600 / TTL calls an
# hour, 12 at the default of 300. Monthly quotas are small (AviationStack free:
# 100 calls; AeroDataBox free: 200 board calls), so redo the arithmetic in
# docs/decisions/0001-data-source-strategy.md before lowering it.
CACHE_TTL_SECONDS=300

# Maximum number of results kept in the cache (one per airport/type or flight
# number looked up). When full, the least recently used entry is evicted, so
# memory stays bounded however many distinct lookups are made. Must be >= 1.
CACHE_MAX_ENTRIES=256

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URL).
CORS_ORIGINS=http://localhost:5173
