# Sign up at https://aviationstack.com/ to get a free API key.
AVIATIONSTACK_API_KEY=your_api_key_here

# How long (seconds) to cache flight results per airport/type before refetching.
CACHE_TTL_SECONDS=60

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URL).
CORS_ORIGINS=http://localhost:5173
